{
    "java.jdt.ls.java.home": "C:\\Program Files\\Eclipse Adoptium\\jdk-17.0.20.101-hotspot",
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-17",
            "path": "C:\\Program Files\\Eclipse Adoptium\\jdk-17.0.20.101-hotspot",
            "default": true
        }
    ],
    "java.project.sourcePaths": [
        "basics"
    ],
    "java.project.outputPath": "basics/out",
    "java.debug.settings.vmArgs": "-Dfile.encoding=UTF-8",
    "java.debug.settings.console": "integratedTerminal",
    "terminal.integrated.automationProfile.windows": {
        "source": "PowerShell",
        "args": [
            "-NoLogo",
            "-NoExit",
            "-Command",
            "chcp 65001"
        ]
    },
    "code-runner.executorMap": {
        "java": "cd $dir && chcp 65001 && New-Item -ItemType Directory -Force out | Out-Null; javac -encoding UTF-8 -d out *.java && java '-Dfile.encoding=UTF-8' -cp out $fileNameWithoutExt"
    },
    "code-runner.runInTerminal": true
}

